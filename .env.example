# Copy this file to `.env` and fill in each value.
# `.env` is git-ignored; never commit real secrets.

# PostgreSQL connection string.
DATABASE_URL="YOUR_DATABASE_URL"

# Port the API listens on.
PORT="YOUR_PORT"

# Runtime mode: development | production.
NODE_ENV="YOUR_NODE_ENV"

# Base path for all API routes.
API_PREFIX="YOUR_API_PREFIX"

# Frontend origin allowed to send credentialed requests.
FRONTEND_URL="YOUR_FRONTEND_URL"

# Number of trusted reverse proxies. Use 0 for local development.
TRUST_PROXY="YOUR_TRUST_PROXY"

# bcrypt cost factor (10-15 recommended).
BCRYPT_SALT_ROUNDS="YOUR_BCRYPT_SALT_ROUNDS"

# Random secret for access tokens (32+ characters).
JWT_ACCESS_SECRET="YOUR_JWT_ACCESS_SECRET"
JWT_REFRESH_SECRET="YOUR_JWT_REFRESH_SECRET"
JWT_ACCESS_EXPIRES_IN="YOUR_JWT_ACCESS_EXPIRES_IN"
JWT_REFRESH_EXPIRES_IN="YOUR_JWT_REFRESH_EXPIRES_IN"
JWT_ISSUER="YOUR_JWT_ISSUER"
JWT_AUDIENCE="YOUR_JWT_AUDIENCE"

# Cloudinary credentials (all three required to enable issue photo uploads).
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# Cookie SameSite policy: lax | strict | none.
COOKIE_SAME_SITE="YOUR_COOKIE_SAME_SITE"
COOKIE_SECURE="YOUR_COOKIE_SECURE"
COOKIE_DOMAIN="YOUR_COOKIE_DOMAIN"

# Redis username.
REDIS_USER="YOUR_REDIS_USER"
REDIS_PASSWORD="YOUR_REDIS_PASSWORD"
REDIS_HOST="YOUR_REDIS_HOST"
REDIS_PORT="YOUR_REDIS_PORT"

# Public GET responses are cached in Redis when it is available.
CACHE_ENABLED="true"
CACHE_TTL_SECONDS="60"

# Keep "inline" for Vercel/serverless. Use "queue" with a separate worker process.
JOBS_MODE="inline"
JOBS_QUEUE_NAME="civicpulse-jobs"
JOBS_REDIS_TLS="false"

# SMTP login address.
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
EMAIL_SENDER="YOUR_EMAIL_SENDER"

# OTP lifetime in seconds.
OTP_EXPIRES_IN_SECONDS="YOUR_OTP_EXPIRES_IN_SECONDS"
REGISTRATION_SESSION_EXPIRES_IN_SECONDS="YOUR_REGISTRATION_SESSION_EXPIRES_IN_SECONDS"
LOGIN_LOCKOUT_THRESHOLD="5"
LOGIN_LOCKOUT_WINDOW_SECONDS="900"
LOGIN_LOCKOUT_DURATION_SECONDS="900"

# Demo data is disabled by default and rejected in production.
# Enable only for local development after providing all demo credentials below.
SEED_ON_START="false"

# Demo admin (required only when SEED_ON_START=true).
SEED_ADMIN_NAME="Local Admin"
SEED_ADMIN_EMAIL="YOUR_SEED_ADMIN_EMAIL"
SEED_ADMIN_PASSWORD="YOUR_SEED_ADMIN_PASSWORD"
SEED_ADMIN_IMAGE_URL=""

# Demo personnel (required only when SEED_ON_START=true).
SEED_PERSONNEL_NAME="Local Personnel"
SEED_PERSONNEL_EMAIL="YOUR_SEED_PERSONNEL_EMAIL"
SEED_PERSONNEL_PASSWORD="YOUR_SEED_PERSONNEL_PASSWORD"
SEED_PERSONNEL_IMAGE_URL=""

# Demo citizen (required only when SEED_ON_START=true).
SEED_CITIZEN_NAME="Local Citizen"
SEED_CITIZEN_EMAIL="YOUR_SEED_CITIZEN_EMAIL"
SEED_CITIZEN_PASSWORD="YOUR_SEED_CITIZEN_PASSWORD"
SEED_CITIZEN_IMAGE_URL=""

# AI provider: local (offline, no key) | openai | gemini.
# Keep the key server-side only; never expose it to the browser.
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="8000"
AI_MAX_TOKENS="512"
AI_TEMPERATURE="0.2"
AI_DAILY_LIMIT_PER_USER="100"
AI_CACHE_TTL_SECONDS="300"
AI_MAX_CORPUS_ITEMS="500"
