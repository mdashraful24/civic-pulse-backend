# Copy this file to `.env` and fill in each value.
# `.env` is git-ignored; never commit real secrets.

# PostgreSQL connection string.
DATABASE_URL="YOUR_DATABASE_URL"

# Port the API listens on.
PORT="YOUR_PORT"

# Runtime mode: development | production.
NODE_ENV="YOUR_NODE_ENV"

# Base path for all API routes.
API_PREFIX="YOUR_API_PREFIX"

# Frontend origin allowed to send credentialed requests.
FRONTEND_URL="YOUR_FRONTEND_URL"

# Number of trusted reverse proxies. Use 0 for local development.
TRUST_PROXY="YOUR_TRUST_PROXY"

# bcrypt cost factor (10-15 recommended).
BCRYPT_SALT_ROUNDS="YOUR_BCRYPT_SALT_ROUNDS"

# Random secret for access tokens (32+ characters).
JWT_ACCESS_SECRET="YOUR_JWT_ACCESS_SECRET"

# Different random secret for refresh tokens (32+ characters).
JWT_REFRESH_SECRET="YOUR_JWT_REFRESH_SECRET"

# Access token lifetime (e.g. 15m).
JWT_ACCESS_EXPIRES_IN="YOUR_JWT_ACCESS_EXPIRES_IN"

# Refresh token lifetime (e.g. 7d).
JWT_REFRESH_EXPIRES_IN="YOUR_JWT_REFRESH_EXPIRES_IN"

# JWT issuer name.
JWT_ISSUER="YOUR_JWT_ISSUER"

# JWT audience name.
JWT_AUDIENCE="YOUR_JWT_AUDIENCE"

# Cloudinary cloud name.
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"

# Cloudinary API key.
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"

# Cloudinary API secret.
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# Cookie SameSite policy: lax | strict | none.
COOKIE_SAME_SITE="YOUR_COOKIE_SAME_SITE"

# Send cookies over HTTPS only. Use true in production.
COOKIE_SECURE="YOUR_COOKIE_SECURE"

# Optional cookie domain (e.g. .example.com).
COOKIE_DOMAIN="YOUR_COOKIE_DOMAIN"

# Redis username.
REDIS_USER="YOUR_REDIS_USER"

# Redis password.
REDIS_PASSWORD="YOUR_REDIS_PASSWORD"

# Redis host.
REDIS_HOST="YOUR_REDIS_HOST"

# Redis port.
REDIS_PORT="YOUR_REDIS_PORT"

# SMTP login address.
SMTP_USER="YOUR_SMTP_USER"

# SMTP password or app password.
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"

# From address shown to email recipients.
EMAIL_SENDER="YOUR_EMAIL_SENDER"

# OTP lifetime in seconds.
OTP_EXPIRES_IN_SECONDS="YOUR_OTP_EXPIRES_IN_SECONDS"

# Pending registration lifetime in seconds.
REGISTRATION_SESSION_EXPIRES_IN_SECONDS="YOUR_REGISTRATION_SESSION_EXPIRES_IN_SECONDS"

# Create demo accounts on boot: true | false.
SEED_ON_START="YOUR_SEED_ON_START"

# Demo admin name.
SEED_ADMIN_NAME="YOUR_SEED_ADMIN_NAME"

# Demo admin email.
SEED_ADMIN_EMAIL="YOUR_SEED_ADMIN_EMAIL"

# Demo admin password.
SEED_ADMIN_PASSWORD="YOUR_SEED_ADMIN_PASSWORD"

# Demo personnel name.
SEED_PERSONNEL_NAME="YOUR_SEED_PERSONNEL_NAME"

# Demo personnel email.
SEED_PERSONNEL_EMAIL="YOUR_SEED_PERSONNEL_EMAIL"

# Demo personnel password.
SEED_PERSONNEL_PASSWORD="YOUR_SEED_PERSONNEL_PASSWORD"

# Demo citizen name.
SEED_CITIZEN_NAME="YOUR_SEED_CITIZEN_NAME"

# Demo citizen email.
SEED_CITIZEN_EMAIL="YOUR_SEED_CITIZEN_EMAIL"

# Demo citizen password.
SEED_CITIZEN_PASSWORD="YOUR_SEED_CITIZEN_PASSWORD"
