model Issue {
  id String @id @default(uuid())

  title         String
  description   String
  category      IssueCategory
  location      String
  imageUrl      String?
  imagePublicId String?

  priority         IssuePriority    @default(MEDIUM)
  status           IssueStatus      @default(PENDING)
  moderationStatus ModerationStatus @default(VISIBLE)

  reporterId String
  reporter   User   @relation("ReportedIssues", fields: [reporterId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history IssueHistory[]
  flags   ModerationFlag[]

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([moderationStatus, createdAt(sort: Desc)])
  @@index([moderationStatus, updatedAt(sort: Desc)])
  @@index([moderationStatus, priority(sort: Desc), createdAt(sort: Desc)])
  @@index([reporterId, createdAt(sort: Desc)])
  @@index([assigneeId, createdAt(sort: Desc)])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([location(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("issues")
}
