model Issue {
  id String @id @default(uuid())

  title         String
  description   String
  category      IssueCategory
  location      String
  imageUrl      String?
  imagePublicId String?

  priority IssuePriority @default(MEDIUM)
  status   IssueStatus   @default(PENDING)

  reporterId String
  reporter   User   @relation("ReportedIssues", fields: [reporterId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("AssignedIssues", fields: [assigneeId], references: [id], onDelete: SetNull)

  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history IssueHistory[]

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([createdAt])
  @@map("issues")
}
